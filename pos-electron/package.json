{
  "name": "sumen_pos",
  "private": true,
  "version": "0.1.2",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder -p always",
    "electron:start": "electron .",
    "start": "concurrently \"npm run dev\" \"npm run electron:start\""
  },
  "dependencies": {
    "axios": "^1.15.2",
    "electron-updater": "^6.8.3",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "escpos-usb": "^3.0.0-alpha.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "socket.io-client": "^4.8.3",
    "usb": "^1.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.sumen.pos",
    "productName": "Sümen POS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "preload.js",
      "logo.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ahmetnygt",
        "repo": "sumen_pos",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}